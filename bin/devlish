#!/usr/bin/env bash
# Development CLI - delegates to the native Rust binary (devlish-core).
# This mutable discovery wrapper is not a trusted bootstrap verifier.
if [ "${DEVLISH_VERIFIED_PROFILE+x}" = x ] ||
   [ "${1-}" = run-verified ] || [ "${1-}" = serve-verified ]; then
  echo "Verified mode requires an operator-selected, protected native executable; the development wrapper cannot verify its candidate." >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Find the devlish-core binary
if [ -x "$REPO_ROOT/crates/devlish_core/target/release/devlish-core" ]; then
  exec "$REPO_ROOT/crates/devlish_core/target/release/devlish-core" "$@"
elif [ -x "$REPO_ROOT/crates/devlish_core/target/debug/devlish-core" ]; then
  exec "$REPO_ROOT/crates/devlish_core/target/debug/devlish-core" "$@"
elif command -v devlish-core >/dev/null 2>&1; then
  exec devlish-core "$@"
else
  echo "devlish-core binary not found." >&2
  echo "Build it with: cd crates/devlish_core && cargo build --release" >&2
  exit 1
fi
