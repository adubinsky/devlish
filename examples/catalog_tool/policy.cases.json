    "expected": {
      "allow": false,
      "reason": "Private data, alternate programs, arguments and output are not approved."
    }
  },
  {
    "name": "Tool output disclosure",
    "input": {
      "effect": "respond",
      "request": {
        "value": "SYNTHETIC_COMPANY_IP"
      }
    },
    "expected": {
      "allow": false,
