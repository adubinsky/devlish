[
  {
    "name": "allow minimal internal decision",
    "input": {
      "effect": "call_service",
      "request": {
        "service": "LoanReview",
        "action": "record_decision",
        "arguments": {
          "loan_token": "loan_AB12CD34",
          "decision": "needs_review"
        }
      }
    },
    "expected": {
      "allow": true,
      "reason": "Only a loan token and review status may reach LoanReview.record_decision."
    }
  },
  {
    "name": "allow fixed acknowledgement",
    "input": {
      "effect": "respond",
