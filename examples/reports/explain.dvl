# Human-facing conclusions are executable English, not generated by a model.
# The CLI verifies report integrity before passing it to this program.
Ask "Which verified report should be explained?" as report

If passed of report equals false:
  Respond with "FAIL: One or more checks failed. Review the failing checks in the report."

If kind of report equals "application":
  Respond with "PASS: The measured application files match the supplied manifest. Build provenance and approval of that manifest have not been authenticated."

If kind of report equals "policy":
  Respond with "PASS: The policy reproduced every supplied expected decision. This establishes the tested cases, not exhaustive policy coverage."

If kind of report equals "process":
  details equals details of report
  If execution_succeeded of details equals false:
    Respond with "PASS: Offline replay reproduced the recorded decisions and failure. The original execution failed or was blocked; this is not task success."
  If execution_completed of details equals false:
    Respond with "PASS: Offline replay reproduced a paused execution. The task has not completed."
  Respond with "PASS: Offline replay reproduced the recorded decisions and result without live tool calls. This does not independently attest the host or establish business-task correctness."

If kind of report equals "verification":
  details equals details of report
  If anchor_checked of details equals true:
    Respond with "PASS: Report integrity matches the supplied external digest. The underlying checks were not rerun and no signature was verified."
  Respond with "PASS: The report is internally consistent. No external digest was checked, so a complete rewrite cannot be detected."

Fail with "Unsupported report kind."
