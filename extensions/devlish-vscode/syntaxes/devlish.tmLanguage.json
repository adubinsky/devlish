{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Devlish",
  "scopeName": "source.devlish",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#class-header" },
    { "include": "#method-definition" },
    { "include": "#control-keywords" },
    { "include": "#declaration-keywords" },
    { "include": "#action-keywords" },
    { "include": "#respond-with" },
    { "include": "#validation-operators" },
    { "include": "#comparison-operators" },
    { "include": "#arithmetic-operators" },
    { "include": "#logical-operators" },
    { "include": "#symbol-operators" },
    { "include": "#builtin-functions" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.devlish",
      "match": "#.*$"
    },
    "strings": {
      "name": "string.quoted.double.devlish",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.devlish",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.devlish",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "class-header": {
      "name": "entity.name.class.devlish",
      "match": "^\\w[\\w ]*'s\\s+\\w[\\w ]*:\\s*$"
    },
    "method-definition": {
      "patterns": [
        {
          "comment": "Private method definition",
          "match": "^(\\s+)(private\\s+)(\\w[\\w ]*?)\\s*:\\s*$",
          "captures": {
            "2": { "name": "storage.modifier.devlish" },
            "3": { "name": "entity.name.function.devlish" }
          }
        },
        {
          "comment": "Method definition with parameters",
          "match": "^(\\s+)(\\w[\\w ]*?)\\s+(using)\\s+(\\w[\\w ,]*?)\\s*:\\s*$",
          "captures": {
            "2": { "name": "entity.name.function.devlish" },
            "3": { "name": "keyword.other.devlish" },
            "4": { "name": "variable.parameter.devlish" }
          }
        },
        {
          "comment": "Method definition without parameters",
          "match": "^(\\s+)(\\w[\\w ]*?)\\s*:\\s*$",
          "captures": {
            "2": { "name": "entity.name.function.devlish" }
          }
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.devlish",
          "match": "^\\s*(If|Otherwise|For each|While|Until|Try)\\b"
        },
        {
          "name": "keyword.control.devlish",
          "match": "\\b(if|otherwise)\\b"
        },
        {
          "name": "keyword.control.devlish",
          "match": "^\\s*(Break|Continue)\\b"
        }
      ]
    },
    "declaration-keywords": {
      "patterns": [
        {
          "name": "keyword.other.devlish",
          "match": "^\\s*(Set|Load|Import|Export)\\b"
        },
        {
          "name": "keyword.other.devlish",
          "match": "\\b(as)\\b"
        }
      ]
    },
    "action-keywords": {
      "patterns": [
        {
          "name": "keyword.other.devlish",
          "match": "^\\s*(Print|Checkpoint|Ask)\\b"
        },
        {
          "name": "keyword.other.devlish",
          "match": "\\b(Fail with|fail with)\\b"
        },
        {
          "name": "keyword.other.devlish",
          "match": "^\\s*(Require|Expect)\\b"
        }
      ]
    },
    "respond-with": {
      "name": "keyword.control.return.devlish",
      "match": "\\b(respond with)\\b"
    },
    "validation-operators": {
      "name": "keyword.operator.validation.devlish",
      "match": "\\b(must contain|must equal|must be present|must be missing|must match|must be one of)\\b"
    },
    "comparison-operators": {
      "patterns": [
        {
          "name": "keyword.operator.devlish",
          "match": "\\b(equals|contains|is greater than|is less than|is at least|is at most|is not|is)\\b"
        },
        {
          "name": "keyword.operator.comparison.devlish",
          "match": "(>=|<=|>|<)"
        }
      ]
    },
    "arithmetic-operators": {
      "name": "keyword.operator.arithmetic.devlish",
      "match": "\\b(plus|minus|times|divided by)\\b"
    },
    "logical-operators": {
      "name": "keyword.operator.logical.devlish",
      "match": "\\b(and|or|not)\\b"
    },
    "symbol-operators": {
      "name": "keyword.operator.devlish",
      "match": "\\b(in)\\b"
    },
    "builtin-functions": {
      "name": "support.function.devlish",
      "match": "\\b(count of|first of|last of|unique of|flatten of|minimum of|maximum of|sum of|average of|reverse of|sort of|find where|filter where|reject where|any where|all where|partition where|group by|index by|take|drop|zip|chunk|union of|intersection of|difference of|map transform|pluck|uppercase of|lowercase of|trim of|normalize whitespace of|slugify of|title case of|sentence case of|words of|contains text|starts with text|ends with text|date parse|date add days|days between|business days between|length of|round of|abs of|absolute value of|replace|split|join|item|slice|keys of|values of|entries of|has fields|matches shape|type of)\\b"
    },
    "constants": {
      "name": "constant.language.devlish",
      "match": "\\b(true|false|nil|nothing)\\b"
    }
  }
}
